{
  "name": "prompt-lupinum",
  "displayName": "prompt.lupinum",
  "version": "1.6.1",
  "description": "Select codebase files, manage reusable prompt prefixes, and create AI-ready context.",
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "ai context",
    "ai prompts",
    "claude",
    "clipboard",
    "code context",
    "context",
    "context management",
    "copy context",
    "developer tools",
    "gemini",
    "llm",
    "openai",
    "prompt",
    "prompt templates",
    "vscode"
  ],
  "homepage": "https://github.com/matthias/prompt-lupinum",
  "bugs": {
    "url": "https://github.com/matthias/prompt-lupinum/issues"
  },
  "license": "AGPL-3.0",
  "author": {
    "name": "Michael Ramos",
    "url": "https://github.com/backnotprop"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/matthias/prompt-lupinum"
  },
  "publisher": "backnotprop",
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "vp run package",
    "compile": "vp check && vp run build",
    "watch": "vp build --watch & vp build --config vite.webview.config.mts --watch",
    "build": "vp build && vp build --config vite.webview.config.mts",
    "package": "vp run build",
    "package:vsix": "vp exec vsce package",
    "deploy:local": "sh -c 'VSIX=$(node -p \"const p=require(\\\"./package.json\\\"); p.name + \\\"-\\\" + p.version + \\\".vsix\\\"\"); vp run package:vsix && \"${VSCODE_CLI:-/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code}\" --install-extension \"$VSIX\" --force'",
    "check": "vp check",
    "check-types": "vp check --no-fmt --no-lint",
    "lint": "vp lint src",
    "test": "vp test run",
    "test:architecture": "node scripts/check-architecture.mjs",
    "validate": "vp check && vp test run && vp run test:architecture",
    "benchmark": "node scripts/benchmark.mjs",
    "benchmark:smoke": "node scripts/benchmark.mjs --scale=smoke",
    "benchmark:json": "node scripts/benchmark.mjs --json",
    "prepare": "vp config"
  },
  "dependencies": {
    "ignore": "7.0.5",
    "vue": "3.5.34"
  },
  "devDependencies": {
    "@types/node": "20.19.24",
    "@types/vscode": "1.96.0",
    "@vitejs/plugin-vue": "6.0.7",
    "@vscode/vsce": "3.9.1",
    "@vue/tsconfig": "0.9.1",
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "vite": "8.0.11",
    "vite-plus": "0.1.21"
  },
  "contributes": {
    "configuration": {
      "title": "prompt.lupinum",
      "properties": {
        "promptLupinum.useGitignore": {
          "type": "boolean",
          "default": true,
          "description": "Use your .gitignore file to filter out files and folders available for context"
        },
        "promptLupinum.maxFileSizeWarningKB": {
          "type": "number",
          "default": 500,
          "description": "Show warning when selecting files larger than this size (in KB)"
        },
        "promptLupinum.showTreeTokenCounts": {
          "type": "boolean",
          "default": true,
          "description": "Show estimated token counts next to files and folders in the prompt.lupinum file tree."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "prompt-lupinum",
          "title": "prompt.lupinum",
          "icon": "assets/prompt-lupinum.svg"
        }
      ]
    },
    "views": {
      "prompt-lupinum": [
        {
          "icon": "assets/prompt-lupinum.svg",
          "id": "promptLupinum.files",
          "name": "Files",
          "initialSize": 3,
          "type": "tree"
        },
        {
          "id": "promptLupinum.selectionFilters",
          "name": "Selection Filters",
          "initialSize": 1,
          "type": "tree"
        },
        {
          "id": "promptLupinum.gitCommits",
          "name": "Git Commits",
          "initialSize": 1,
          "type": "tree"
        }
      ]
    },
    "commands": [
      {
        "command": "promptLupinum.copyContext",
        "title": "Copy Context to Clipboard",
        "icon": "$(clippy)"
      },
      {
        "command": "promptLupinum.refresh",
        "title": "Refresh File List",
        "icon": "$(refresh)"
      },
      {
        "command": "promptLupinum.clearSelection",
        "title": "Clear All Selections",
        "category": "prompt.lupinum",
        "icon": "$(clear-all)"
      },
      {
        "command": "promptLupinum.includeAllSelectionFilters",
        "title": "Include All Filters",
        "category": "prompt.lupinum",
        "icon": "$(checklist)"
      },
      {
        "command": "promptLupinum.excludeAllSelectionFilters",
        "title": "Exclude All Filters",
        "category": "prompt.lupinum",
        "icon": "$(list-selection)"
      },
      {
        "command": "promptLupinum.open",
        "title": "Open prompt.lupinum",
        "category": "prompt.lupinum"
      },
      {
        "command": "promptLupinum.showLogs",
        "title": "Show prompt.lupinum Logs",
        "category": "prompt.lupinum",
        "icon": "$(output)"
      },
      {
        "command": "promptLupinum.addCurrentFile",
        "title": "Add Current File to Context",
        "category": "prompt.lupinum",
        "icon": "$(add)"
      },
      {
        "command": "promptLupinum.refreshGitCommits",
        "title": "Refresh Git Commits",
        "category": "prompt.lupinum",
        "icon": "$(refresh)"
      },
      {
        "command": "promptLupinum.clearGitCommits",
        "title": "Clear Commit Selection",
        "category": "prompt.lupinum",
        "icon": "$(clear-all)"
      },
      {
        "command": "promptLupinum.selectLatestGitCommit",
        "title": "Select Latest Commit",
        "category": "prompt.lupinum",
        "icon": "$(git-commit)"
      },
      {
        "command": "promptLupinum.selectLatestThreeGitCommits",
        "title": "Select Latest 3 Commits",
        "category": "prompt.lupinum",
        "icon": "$(git-commit)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "promptLupinum.copyContext"
        },
        {
          "command": "promptLupinum.refresh",
          "when": "view == promptLupinum.files"
        },
        {
          "command": "promptLupinum.open"
        },
        {
          "command": "promptLupinum.showLogs"
        },
        {
          "command": "promptLupinum.clearSelection"
        },
        {
          "command": "promptLupinum.includeAllSelectionFilters"
        },
        {
          "command": "promptLupinum.excludeAllSelectionFilters"
        },
        {
          "command": "promptLupinum.addCurrentFile"
        },
        {
          "command": "promptLupinum.refreshGitCommits"
        },
        {
          "command": "promptLupinum.clearGitCommits"
        },
        {
          "command": "promptLupinum.selectLatestGitCommit"
        },
        {
          "command": "promptLupinum.selectLatestThreeGitCommits"
        }
      ],
      "view/title": [
        {
          "command": "promptLupinum.copyContext",
          "when": "view == promptLupinum.files",
          "group": "navigation@1"
        },
        {
          "command": "promptLupinum.refresh",
          "when": "view == promptLupinum.files",
          "group": "navigation@3"
        },
        {
          "command": "promptLupinum.clearSelection",
          "when": "view == promptLupinum.files",
          "group": "navigation@4"
        },
        {
          "command": "promptLupinum.showLogs",
          "when": "view == promptLupinum.files",
          "group": "navigation@5"
        },
        {
          "command": "promptLupinum.includeAllSelectionFilters",
          "when": "view == promptLupinum.selectionFilters",
          "group": "navigation@1"
        },
        {
          "command": "promptLupinum.excludeAllSelectionFilters",
          "when": "view == promptLupinum.selectionFilters",
          "group": "navigation@2"
        },
        {
          "command": "promptLupinum.selectLatestGitCommit",
          "when": "view == promptLupinum.gitCommits",
          "group": "navigation@1"
        },
        {
          "command": "promptLupinum.selectLatestThreeGitCommits",
          "when": "view == promptLupinum.gitCommits",
          "group": "navigation@2"
        },
        {
          "command": "promptLupinum.refreshGitCommits",
          "when": "view == promptLupinum.gitCommits",
          "group": "navigation@3"
        },
        {
          "command": "promptLupinum.clearGitCommits",
          "when": "view == promptLupinum.gitCommits",
          "group": "navigation@4"
        }
      ],
      "editor/context": [
        {
          "command": "promptLupinum.addCurrentFile",
          "when": "editorTextFocus",
          "group": "9_cutcopypaste"
        },
        {
          "command": "promptLupinum.open",
          "when": "editorTextFocus",
          "group": "9_cutcopypaste"
        }
      ]
    }
  },
  "activationEvents": [
    "onCommand:promptLupinum.addCurrentFile",
    "onCommand:promptLupinum.clearGitCommits",
    "onCommand:promptLupinum.clearSelection",
    "onCommand:promptLupinum.copyContext",
    "onCommand:promptLupinum.excludeAllSelectionFilters",
    "onCommand:promptLupinum.includeAllSelectionFilters",
    "onCommand:promptLupinum.open",
    "onCommand:promptLupinum.refresh",
    "onCommand:promptLupinum.refreshGitCommits",
    "onCommand:promptLupinum.selectLatestGitCommit",
    "onCommand:promptLupinum.selectLatestThreeGitCommits",
    "onCommand:promptLupinum.showLogs",
    "onView:promptLupinum.files",
    "onView:promptLupinum.gitCommits",
    "onView:promptLupinum.selectionFilters"
  ],
  "icon": "assets/prompt-lupinum-icon.png",
  "engines": {
    "vscode": "^1.96.0"
  },
  "packageManager": "npm@11.14.1"
}
