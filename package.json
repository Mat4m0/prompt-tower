{
  "name": "prompt-lupinum",
  "displayName": "prompt.lupinum",
  "version": "1.6.1",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/matthias/prompt-lupinum"
  },
  "author": {
    "name": "Michael Ramos",
    "url": "https://github.com/backnotprop"
  },
  "publisher": "backnotprop",
  "icon": "assets/prompt-lupinum-icon.png",
  "description": "Select codebase files, manage reusable prompt prefixes, and create AI-ready context.",
  "categories": [
    "AI",
    "Machine Learning",
    "Programming Languages",
    "Chat",
    "Other"
  ],
  "engines": {
    "vscode": "^1.96.0"
  },
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "prompt.lupinum",
      "properties": {
        "promptLupinum.useGitignore": {
          "type": "boolean",
          "default": true,
          "description": "Use your .gitignore file to filter out files and folders available for context"
        },
        "promptLupinum.maxFileSizeWarningKB": {
          "type": "number",
          "default": 500,
          "description": "Show warning when selecting files larger than this size (in KB)"
        },
        "promptLupinum.showTreeTokenCounts": {
          "type": "boolean",
          "default": true,
          "description": "Show estimated token counts next to files and folders in the prompt.lupinum file tree."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "prompt-lupinum",
          "title": "prompt.lupinum",
          "icon": "assets/prompt-lupinum.svg"
        }
      ]
    },
    "views": {
      "prompt-lupinum": [
        {
          "icon": "assets/prompt-lupinum.svg",
          "id": "promptLupinum.files",
          "name": "Files",
          "type": "tree"
        },
        {
          "id": "promptLupinum.selectionFilters",
          "name": "Selection Filters",
          "type": "tree"
        }
      ]
    },
    "commands": [
      {
        "command": "promptLupinum.copyContext",
        "title": "Copy Context to Clipboard",
        "icon": "$(clippy)"
      },
      {
        "command": "promptLupinum.refresh",
        "title": "Refresh File List",
        "icon": "$(refresh)"
      },
      {
        "command": "promptLupinum.clearSelection",
        "title": "Clear All Selections",
        "category": "prompt.lupinum",
        "icon": "$(clear-all)"
      },
      {
        "command": "promptLupinum.includeAllSelectionFilters",
        "title": "Include All Selection Filters",
        "category": "prompt.lupinum",
        "icon": "$(checklist)"
      },
      {
        "command": "promptLupinum.excludeAllSelectionFilters",
        "title": "Exclude All Selection Filters",
        "category": "prompt.lupinum",
        "icon": "$(list-selection)"
      },
      {
        "command": "promptLupinum.open",
        "title": "Open prompt.lupinum",
        "category": "prompt.lupinum"
      },
      {
        "command": "promptLupinum.showLogs",
        "title": "Show prompt.lupinum Logs",
        "category": "prompt.lupinum",
        "icon": "$(output)"
      },
      {
        "command": "promptLupinum.addCurrentFile",
        "title": "Add to prompt.lupinum",
        "category": "prompt.lupinum",
        "icon": "$(add)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "promptLupinum.copyContext"
        },
        {
          "command": "promptLupinum.refresh",
          "when": "view == promptLupinum.files"
        },
        {
          "command": "promptLupinum.open"
        },
        {
          "command": "promptLupinum.showLogs"
        },
        {
          "command": "promptLupinum.clearSelection"
        },
        {
          "command": "promptLupinum.includeAllSelectionFilters"
        },
        {
          "command": "promptLupinum.excludeAllSelectionFilters"
        },
        {
          "command": "promptLupinum.addCurrentFile"
        }
      ],
      "view/title": [
        {
          "command": "promptLupinum.copyContext",
          "when": "view == promptLupinum.files",
          "group": "navigation@1"
        },
        {
          "command": "promptLupinum.refresh",
          "when": "view == promptLupinum.files",
          "group": "navigation@3"
        },
        {
          "command": "promptLupinum.clearSelection",
          "when": "view == promptLupinum.files",
          "group": "navigation@4"
        },
        {
          "command": "promptLupinum.showLogs",
          "when": "view == promptLupinum.files",
          "group": "navigation@5"
        },
        {
          "command": "promptLupinum.includeAllSelectionFilters",
          "when": "view == promptLupinum.selectionFilters",
          "group": "navigation@1"
        },
        {
          "command": "promptLupinum.excludeAllSelectionFilters",
          "when": "view == promptLupinum.selectionFilters",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "promptLupinum.addCurrentFile",
          "when": "editorTextFocus",
          "group": "9_cutcopypaste"
        },
        {
          "command": "promptLupinum.open",
          "when": "editorTextFocus",
          "group": "9_cutcopypaste"
        }
      ]
    }
  },
  "homepage": "https://github.com/matthias/prompt-lupinum",
  "bugs": {
    "url": "https://github.com/matthias/prompt-lupinum/issues"
  },
  "keywords": [
    "AI",
    "prompt",
    "LLM",
    "context",
    "clipboard",
    "copy context",
    "ai",
    "AI Code Assistant",
    "AI Context Management",
    "AI Prompt Engineering",
    "AI Studio",
    "AI-Powered Coding",
    "assistant",
    "autocomplete",
    "c#",
    "c++",
    "ChatGPT",
    "Claude",
    "Claude Code",
    "code",
    "context creation",
    "context injection",
    "context management",
    "Copilot",
    "Cursor",
    "DeepSeek",
    "Developer Productivity",
    "free",
    "Gemini",
    "go",
    "golang",
    "Grok",
    "HuggingChat",
    "javascript",
    "json",
    "kotlin",
    "llm code context",
    "llm code prompts",
    "mcp",
    "Mistral",
    "openai",
    "php",
    "prompt templates",
    "python",
    "refactoring",
    "RooCode",
    "ruby",
    "Sonnet",
    "tools",
    "typescript",
    "vibe coding",
    "VS Code",
    "yaml"
  ],
  "scripts": {
    "vscode:prepublish": "npm run package",
    "benchmark": "node scripts/benchmark.mjs",
    "benchmark:smoke": "node scripts/benchmark.mjs --scale=smoke",
    "benchmark:json": "node scripts/benchmark.mjs --json",
    "test": "node scripts/test.mjs",
    "test:architecture": "node scripts/check-architecture.mjs",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "package:vsix": "npx @vscode/vsce package",
    "deploy:local": "sh -c 'VSIX=$(node -p \"const p=require(\\\"./package.json\\\"); p.name + \\\"-\\\" + p.version + \\\".vsix\\\"\"); npx @vscode/vsce package && \"${VSCODE_CLI:-/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code}\" --install-extension \"$VSIX\" --force'",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "validate": "npm run check-types && npm run lint && npm test && npm run test:architecture"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "esbuild": "^0.25.2",
    "eslint": "^9.16.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "ignore": "^7.0.3"
  }
}
